OpC4: ; $C4 CNZ, 11 cycles
  If (FR & 255) <> 0
    Res = M((CpuPC + 1) & $FFFF) << 8
    Ea = Res | M(CpuPC)
    CpuPC = (CpuPC + 2) & $FFFF
    Push16(CpuPC)
    CpuPC = Ea
    Charge(6)
  Else
    CpuPC = (CpuPC + 2) & $FFFF
  EndIf
  NextOp11()

OpC5: ; $C5 PUSH B, 11 cycles
  Push16(CpuBC)
  NextOp11()

OpC6: ; $C6 ADI, 7 cycles
  Res = M(CpuPC)
  FA = CpuA ! Res
  Res = CpuA + Res
  FC = Res
  CpuA = Res & 255
  FR = CpuA
  CpuPC = (CpuPC + 1) & $FFFF
  NextOp7()

OpC7: ; $C7 RST 0, 11 cycles
  Push16(CpuPC)
  CpuPC = $00
