; USB serial text helpers shared by the demo and the diagnostics.
Procedure Say(*text.i)
  Protected p.i, c.i
  p = *text
  c = PeekA(p) & 255
  While c
    UsbSerialWrite(c)
    p = p + 1
    c = PeekA(p) & 255
  Wend
EndProcedure
Procedure Num(v.i)
  Protected d.i
  If v < 0
    UsbSerialWrite(45)
    v = 0 - v
  EndIf
  d = 1
  While v / d >= 10
    d = d * 10
  Wend
  While d > 0
    UsbSerialWrite(48 + (v / d) % 10)
    d = d / 10
  Wend
EndProcedure
Procedure Hex(v.i, digits.i)
  Protected i.i, n.i
  For i = digits - 1 To 0 Step -1
    n = (v >> (i * 4)) & 15
    If n < 10
      UsbSerialWrite(48 + n)
    Else
      UsbSerialWrite(55 + n)
    EndIf
  Next
EndProcedure
Procedure Eol()
  UsbSerialWrite(13) : UsbSerialWrite(10)
  UsbSerialFlush() : UsbSerialTask()
EndProcedure
Procedure WaitUs(us.i)
  Protected t.i
  t = Micros()
  While Micros() - t < us
    UsbSerialTask() : SafetyPet()
  Wend
EndProcedure
; count * 1e6 / us without overflowing a signed 32-bit integer.
Procedure.i Rate(count.i, us.i)
  Protected q.i, remainder.i, digit.i
  q = count / us : remainder = count % us
  For digit = 1 To 6
    remainder = remainder * 10
    q = q * 10 + remainder / us
    remainder = remainder % us
  Next
  ProcedureReturn q
EndProcedure
