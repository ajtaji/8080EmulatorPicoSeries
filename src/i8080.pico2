  FA = CpuA ! Res ! $10
  Res = CpuA - Res
  FC = Res
  FR = Res & 255
  NextOp4()

OpC0: ; $C0 RNZ, 5 cycles
  If (FR & 255) <> 0
    Pop16(CpuPC)
    Charge(6)
  EndIf
  NextOp5()

OpC1: ; $C1 POP B, 10 cycles
  Pop16(CpuBC)
  NextOp10()

OpC2: ; $C2 JNZ, 10 cycles
  If (FR & 255) <> 0
    Res = M((CpuPC + 1) & $FFFF) << 8
    CpuPC = Res | M(CpuPC)
  Else
    CpuPC = (CpuPC + 2) & $FFFF
  EndIf
  NextOp10()

OpC3: ; $C3 JMP, 10 cycles
  Res = M((CpuPC + 1) & $FFFF) << 8
  CpuPC = Res | M(CpuPC)
