OpFA: ; $FA JM, 10 cycles
  If (FR & $8080) <> 0
    Res = M((CpuPC + 1) & $FFFF) << 8
    CpuPC = Res | M(CpuPC)
  Else
    CpuPC = (CpuPC + 2) & $FFFF
  EndIf
  NextOp10()

OpFB: ; $FB EI, 4 cycles
  CpuIE = 1
  CompilerIf #CPU_TIMING = 1
    Left = Left - 4
  CompilerElse
    Left = Left - 1
  CompilerEndIf
  If Left <= 0
    CpuEiDelay = 1
    Goto Done
  EndIf
  DispatchNext()

OpFC: ; $FC CM, 11 cycles
  If (FR & $8080) <> 0
    Res = M((CpuPC + 1) & $FFFF) << 8
    Ea = Res | M(CpuPC)
    CpuPC = (CpuPC + 2) & $FFFF
    Push16(CpuPC)
    CpuPC = Ea
    Charge(6)
