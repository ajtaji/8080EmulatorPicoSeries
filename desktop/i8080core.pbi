  OpTable($FF) = @OpFF()
EndProcedure
Procedure.i CpuRun(n.i)
  If n <= 0
    ProcedureReturn 0
  EndIf
  If CpuHalted
    ProcedureReturn n
  EndIf
  If OpTable(0) = 0
    CpuInitOpTable()
  EndIf
  CpuEiDelay = 0 : CpuYield = 0
  Budget = n : Left = n
  While Left > 0 And CpuYield = 0
    Tmp = M(CpuPC)
    CpuPC = (CpuPC + 1) & $FFFF
    Left - CycTab(Tmp)
    CpuInstr + 1
    CallFunctionFast(OpTable(Tmp))
    If CpuHalted
      Break
    EndIf
  Wend
  CpuYield = 0
  ProcedureReturn Budget - Left
EndProcedure
CompilerEndIf

