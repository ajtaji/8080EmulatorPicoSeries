OpFD: ; $FD CALL (undocumented), 17 cycles
  Res = M((CpuPC + 1) & $FFFF) << 8
  Ea = Res | M(CpuPC)
  CpuPC = (CpuPC + 2) & $FFFF
  Push16(CpuPC)
  CpuPC = Ea
  NextOp17()

OpFE: ; $FE CPI, 7 cycles
  Res = M(CpuPC)
  FA = CpuA ! Res ! $10
  Res = CpuA - Res
  FC = Res
  FR = Res & 255
  CpuPC = (CpuPC + 1) & $FFFF
