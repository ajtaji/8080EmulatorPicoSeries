; PureMetal demo for the Space Invaders board (Intel 8080 at 2 MHz), with
; music and graphics: a UFO crossing the sky, the PUREMETAL logo in the red
; band, a formation of aliens marching to the board's four-note footsteps,
; twinkling stars, a cannon gliding along the ground, a pixel-smooth scrolling
; marquee, and an original tune in A minor on the four tone channels.
;
; Build as an .invaders file; the compiler writes the program ROMs invaders.h,
; .g, .f and .e in demo_roms\ beside the .hex. It runs on this repository's
; Space Invaders machine: desktop\i8080desk.exe (Open... the demo_roms
; folder), desktop\invaders_cli.exe, and the Pico W build (tools/embed_rom.py
; demo\demo_roms, then src\invaders.picow).
;
; The screen: video RAM is column-major. Byte $2400 + x*32 + b holds pixels
; 8b .. 8b+7 of column x, bit 0 the lowest, counting up from the bottom of
; the upright 224 x 256 screen. Every graphic is stored as column bytes, so
; an 8-pixel-tall glyph at a whole byte row is eight byte writes. The
; cabinet's overlay colours rows 32-63 from the top red (bytes 24-27) and
; rows 184-239 green (bytes 2-8).
;
; The tone device (this machine's, not the original board's): channel c at
; port $10 + 4c: +0 period low, +1 period high, +2 volume 0-15, +3 wave
; (0 square, 1 pulse, 2 triangle, 3 noise); 62500 / (period + 1) Hz.

XIncludeFile "demo_assets.invaders"

#VRAM = $2400
#ROW_TOP = 30            ; the title
#ROW_UFO = 28
#ROW_LOGO = 25           ; two bytes: 25 and 26, in the red band
#ROW_STARS_HI = 22       ; stars between the logo and the aliens
#ROW_ALIENS = 19         ; the formation's upper row; the lower is two below
#ROW_STARS_LO = 9
#ROW_CANNON = 7          ; the green band
#ROW_MARQUEE = 4
#ROW_FOOT = 0            ; below the ground line, green between columns 16 and 133

Global frame.a, seen.a, missed.u, loops.u
Global stepTick.a, tuneStep.a, melVol.a, drumVol.a, arpIx.a
Global marqPos.u, marqCol.a
Global alienX.a, alienDir.a, alienRow.a, alienAnim.a, fleetNote.a, fleetOff.a
Global ufoX.u, ufoWait.u, ufoOn.a
Global cannonX.a, cannonDir.a
Global Dim starX.a(12)
Global Dim starRow.a(12)
Global Dim starBit.a(12)

ProcedureInterrupt RST2()
  frame = frame + 1                    ; the vertical blank
EndProcedure

; ---------------------------------------------------------------- drawing
Procedure PutChar(x.u, row.a, c.a)
  Protected src.u, p.u, i.a
  src = ?FontCols + ((c - 32) << 3)
  p = #VRAM + (x << 5) + row
  For i = 0 To 7
    PokeA(p, PeekA(src + i))
    p = p + 32
  Next
EndProcedure

; Zero-terminated text at src, eight columns a character.
Procedure PutText(x.u, row.a, src.u)
  Protected c.a
  c = PeekA(src)
  While c
    PutChar(x, row, c)
    x = x + 8
    src = src + 1
    c = PeekA(src)
  Wend
EndProcedure

Procedure ClearRow(row.a)
  Protected p.u, x.a
  p = #VRAM + row
  For x = 0 To 223
    PokeA(p, 0)
    p = p + 32
  Next
EndProcedure

Procedure DrawLogo()
  Protected p.u, src.u, i.a
  p = #VRAM + (40 << 5) + #ROW_LOGO
  src = ?LogoCols
  For i = 1 To #LOGO_COLUMNS
    PokeA(p, PeekA(src))
    PokeA(p + 1, PeekA(src + 1))
    src = src + 2
    p = p + 32
  Next
EndProcedure

; An alien with two empty columns either side, so a move of two columns
; leaves nothing behind.
Procedure DrawAlien(x.u, row.a, kind.a)
  Protected p.u, src.u, i.a
  src = ?AlienCols + (kind << 3)
  p = #VRAM + ((x - 2) << 5) + row
  PokeA(p, 0) : p = p + 32
  PokeA(p, 0) : p = p + 32
  For i = 0 To 7
    PokeA(p, PeekA(src + i))
    p = p + 32
  Next
  PokeA(p, 0) : p = p + 32
  PokeA(p, 0)
EndProcedure

; The UFO with one empty column behind it (it moves right a column a frame).
Procedure DrawUfo(x.u)
  Protected p.u, i.a
  p = #VRAM + (x << 5) + #ROW_UFO
  PokeA(p, 0)
  p = p + 32
  For i = 0 To 15
    PokeA(p, PeekA(?UfoCols + i))
    p = p + 32
  Next
EndProcedure

; The player's cannon: a 9-column shape with an empty column either side.
Procedure DrawCannon(x.u)
  Protected p.u
  p = #VRAM + ((x - 1) << 5) + #ROW_CANNON
  PokeA(p, 0) : p = p + 32
  PokeA(p, $07) : p = p + 32
  PokeA(p, $0F) : p = p + 32
  PokeA(p, $0F) : p = p + 32
  PokeA(p, $0F) : p = p + 32
  PokeA(p, $7F) : p = p + 32
  PokeA(p, $0F) : p = p + 32
  PokeA(p, $0F) : p = p + 32
  PokeA(p, $0F) : p = p + 32
  PokeA(p, $07) : p = p + 32
  PokeA(p, 0)
EndProcedure

; ---------------------------------------------------------------- the scene
Procedure Aliens()
  Protected i.a, x.u
  alienAnim = 1 - alienAnim
  If alienDir
    alienX = alienX + 2
    If alienX >= 120 : alienDir = 0 : EndIf
  Else
    alienX = alienX - 2
    If alienX <= 10
      alienDir = 1
      ; down a row at the left edge; back to the top from near the ground
      ClearRow(alienRow)
      ClearRow(alienRow - 2)
      alienRow = alienRow - 1
      If alienRow < 12 : alienRow = #ROW_ALIENS : EndIf
    EndIf
  EndIf
  x = alienX
  For i = 0 To 5
    DrawAlien(x, alienRow, alienAnim)
    DrawAlien(x, alienRow - 2, 2 + alienAnim)
    x = x + 16
  Next
  ; the board's four-note march (OUT 5 bits 0-3), one note a step
  i8080_out(5, 1 << fleetNote)
  fleetNote = (fleetNote + 1) & 3
  fleetOff = 2
EndProcedure

Procedure Stars()
  Protected i.a, p.u
  For i = 0 To 11
    If ((frame + i * 5) & 15) = 0
      p = #VRAM + (starX(i) << 5) + starRow(i)
      PokeA(p, PeekA(p) ! starBit(i))
    EndIf
  Next
EndProcedure

Procedure Marquee()
  Protected p.u, x.a, c.a
  ; every column one to the left ...
  p = #VRAM + #ROW_MARQUEE
  For x = 0 To 222
    PokeA(p, PeekA(p + 32))
    p = p + 32
  Next
  ; ... and the text's next column at the right edge
  c = PeekA(?MarqueeText + marqPos)
  PokeA(p, PeekA(?FontCols + ((c - 32) << 3) + marqCol))
  marqCol = marqCol + 1
  If marqCol = 8
    marqCol = 0
    marqPos = marqPos + 1
    If PeekA(?MarqueeText + marqPos) = 0 : marqPos = 0 : EndIf
  EndIf
EndProcedure

Procedure Ufo()
  If ufoOn
    DrawUfo(ufoX)
    ufoX = ufoX + 1
    If ufoX > 207
      ClearRow(#ROW_UFO)
      ufoOn = 0 : ufoWait = 600
      i8080_out(3, 0)
    EndIf
  Else
    ufoWait = ufoWait - 1
    If ufoWait = 0
      ufoOn = 1 : ufoX = 0
      i8080_out(3, 1)                  ; the UFO's warble while it flies
    EndIf
  EndIf
EndProcedure

Procedure Cannon()
  If cannonDir
    cannonX = cannonX + 1
    If cannonX >= 210 : cannonDir = 0 : EndIf
  Else
    cannonX = cannonX - 1
    If cannonX <= 4 : cannonDir = 1 : EndIf
  EndIf
  DrawCannon(cannonX)
EndProcedure

; ---------------------------------------------------------------- music
Procedure.u Period(table.u, index.a)
  ProcedureReturn PeekA(table + (index << 1)) | (PeekA(table + (index << 1) + 1) << 8)
EndProcedure

Procedure MusicStep()
  Protected v.u, d.a
  v = Period(?MelodyPeriods, tuneStep)
  If v
    i8080_out($10, v & 255) : i8080_out($11, v >> 8)
    melVol = 11
  EndIf
  v = Period(?BassPeriods, tuneStep)
  If v
    i8080_out($14, v & 255) : i8080_out($15, v >> 8)
  EndIf
  d = PeekA(?DrumSteps + tuneStep)
  If d = 1                             ; kick: low noise
    i8080_out($1C, 200) : i8080_out($1D, 0) : drumVol = 14
  ElseIf d = 2                         ; snare: high noise
    i8080_out($1C, 12) : i8080_out($1D, 0) : drumVol = 11
  EndIf
  tuneStep = (tuneStep + 1) & 63
EndProcedure

Procedure Music()
  Protected v.u, chord.a
  stepTick = stepTick + 1
  If stepTick >= 8
    stepTick = 0
    MusicStep()
  EndIf
  ; the lead fades a little through each note
  If melVol > 5 And (stepTick & 1)
    melVol = melVol - 1
  EndIf
  i8080_out($12, melVol)
  ; the drums decay quickly
  If drumVol > 0
    If drumVol > 2 : drumVol = drumVol - 3 : Else : drumVol = 0 : EndIf
  EndIf
  i8080_out($1E, drumVol)
  ; the arpeggio: the chord's three notes in turn, two frames each
  If (frame & 1) = 0
    chord = ((tuneStep - 1) & 63) >> 4
    v = Period(?ArpPeriods, chord * 3 + arpIx)
    i8080_out($18, v & 255) : i8080_out($19, v >> 8)
    arpIx = arpIx + 1
    If arpIx = 3 : arpIx = 0 : EndIf
  EndIf
EndProcedure

Procedure MusicBegin()
  i8080_out($13, 0) : i8080_out($17, 2) : i8080_out($1B, 1) : i8080_out($1F, 3)   ; square, triangle, pulse, noise
  i8080_out($16, 13) : i8080_out($1A, 4)                                       ; bass and arpeggio levels
EndProcedure

; ---------------------------------------------------------------- start
Procedure Setup()
  Protected a.u, i.a
  For a = $2400 To $3FFF
    PokeA(a, 0)
  Next
  PutText(36, #ROW_TOP, ?TextTop)
  DrawLogo()
  PutText(32, #ROW_LOGO - 2, ?TextBoard)
  ; the ground: one line of pixels just above the footer
  a = #VRAM + 1
  For i = 0 To 223
    PokeA(a, $80)
    a = a + 32
  Next
  PutText(24, #ROW_FOOT, ?TextFoot)
  ; twelve stars, above and below the formation's sweep
  For i = 0 To 11
    starX(i) = 9 + i * 18
    If i & 1 : starRow(i) = #ROW_STARS_HI : Else : starRow(i) = #ROW_STARS_LO : EndIf
    starBit(i) = 1 << ((i * 3) & 7)
  Next
  alienX = 10 : alienDir = 1 : alienRow = #ROW_ALIENS
  cannonX = 100 : cannonDir = 1
  ufoWait = 120
  MusicBegin()
EndProcedure

Procedure Main()
  Setup()
  EnableInterrupts
  Repeat
    While frame = seen : Wend          ; once a frame
    If (frame - seen) > 1 : missed = missed + 1 : EndIf
    seen = frame
    loops = loops + 1
    i8080_out(6, 0)                    ; the watchdog
    Music()
    Marquee()
    If (seen & 7) = 0 : Aliens() : EndIf
    If fleetOff
      fleetOff = fleetOff - 1
      If fleetOff = 0 : i8080_out(5, 0) : EndIf
    EndIf
    Ufo()
    If seen & 1 : Cannon() : EndIf
    Stars()
  ForEver
EndProcedure

Main()
