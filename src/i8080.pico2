    CpuPC = Ea
    Charge(6)
  Else
    CpuPC = (CpuPC + 2) & $FFFF
  EndIf
  NextOp11()

OpF5: ; $F5 PUSH PSW, 11 cycles
  PackFlags(Tmp)
  Tmp = Tmp | (CpuA << 8)
