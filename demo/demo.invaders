; PureMetal demo for the Space Invaders board (Intel 8080 at 2 MHz), with
; music and graphics: the screen wipes in under the PUREMETAL logo and the
; titles type themselves out; then a formation of aliens marches in a wave to
; the board's four-note footsteps, a UFO patrols the sky, a cannon the
; ground, stars twinkle, a ticker types a message, and an original tune in
; A minor plays on the four tone channels.
;
; Build as an .invaders file (compiler at 9fda90ac8 or later): the compiler
; writes the program ROMs invaders.h, .g, .f and .e in demo_roms\ beside the
; .hex. tools\build_demo.ps1 builds it and runs it headless. Run it on this
; repository's Space Invaders machine: the desktop window (Open... the
; demo_roms folder), desktop\invaders_cli.exe, or the Pico W build
; (py -3 tools/embed_rom.py demo\demo_roms, then src\invaders.picow).
;
; THE BUDGETS. A frame is 33,333 cycles and a byte moved by a loop costs about
; 600 of them, so everything is spread over frames as the original game does
; it: one alien moves a frame, the opening wipe clears one column a frame.
; The program ROM is 8 KB and each statement here compiles to 20-80 bytes, so
; the scene is data: tools/make_demo_assets.py writes a table of moving
; objects (position, step, limits, when they move, animation) that one loop
; runs, and the music writes only the tone registers that change.
;
; THE SCREEN. Video RAM is column-major: byte $2400 + x*32 + b holds pixels
; 8b .. 8b+7 of column x, bit 0 the lowest, counting up from the bottom of
; the upright 224 x 256 screen; every graphic is stored as column bytes. The
; cabinet's overlay colours bytes 24-27 red and bytes 2-8 green.
;
; THE SOUND. This machine's tone device: channel c at port $10 + 4c: +0 period
; low, +1 period high, +2 volume 0-15, +3 wave (0 square, 1 pulse, 2 triangle,
; 3 noise); 62500 / (period + 1) Hz. And the board's own: OUT 5 bits 0-3, the
; fleet's footsteps.

XIncludeFile "demo_assets.invaders"

#VRAM = $2400
#ROW_LOGO = 25           ; bytes 25 and 26, in the red band
#ROW_TICKER = 4

Global frame.a
Global seen.u, loops.u, phase.u, i.u, v.u
Global wipeX.u, textSrc.u, textX.u, textRow.u, textLine.u
Global stepTick.u, tuneStep.u, melVol.u, drumVol.u, fleetNote.u, fleetOff.u
Global tickX.u, tickPos.u
; What changes per object lives in RAM - its distance from its starting
; column (RAM starts at zero) and its direction (0 right) - the rest is read from ObjectTable
; (eight bytes an object: x, row, column data, columns, step, left and right
; limits, animation stride).
Global Dim ObjX.u(#OBJECTS)
Global Dim ObjDir.u(#OBJECTS)
Global Dim ObjFrame.u(#OBJECTS)
Global t.u, ox.u, of.u

ProcedureInterrupt RST2()
  frame = frame + 1                    ; the vertical blank
  stepTick = stepTick + 1              ; the music's clock
EndProcedure

; n column bytes from src into column x upward at byte row `row`, one
; column to the right each.
Procedure Blit(x.u, row.u, src.u, n.u)
  Protected p.u
  p = #VRAM + (x << 5) + row
  While n
    PokeA(p, PeekA(src))
    p = p + 32
    src = src + 1
    n = n - 1
  Wend
EndProcedure

Procedure.u Word(adr.u)
  ProcedureReturn PeekA(adr) | (PeekA(adr + 1) << 8)
EndProcedure

; ---------------------------------------------------------------- opening
; One column a frame: cleared, the ground line drawn, and inside the logo's
; span the logo's column - the logo wipes in with the screen.
Procedure WipeStep()
  Protected p.u, k.u
  p = #VRAM + (wipeX << 5)
  For k = 0 To 31
    PokeA(p + k, 0)
  Next
  PokeA(p + 1, $80)                    ; the ground
  If wipeX >= 40 And wipeX < 40 + #LOGO_COLUMNS
    k = ?LogoCols + ((wipeX - 40) << 1)
    PokeA(p + #ROW_LOGO, PeekA(k))
    PokeA(p + #ROW_LOGO + 1, PeekA(k + 1))
  EndIf
  wipeX = wipeX + 1
  If wipeX = 224
    phase = 1 : textSrc = ?TitleScript
  EndIf
EndProcedure

; Then the titles, typed a character every second frame from TitleScript:
; x, byte row, the characters, 0; 255 ends it.
Procedure TypeStep()
  v = PeekA(textSrc)
  If v = 255
    phase = 2
  ElseIf textX = 0
    textX = v : textRow = PeekA(textSrc + 1) : textSrc = textSrc + 2
  ElseIf v
    Blit(textX, textRow, ?FontCols + ((v - 32) << 3), 8)
    textX = textX + 8 : textSrc = textSrc + 1
  Else
    textX = 0 : textSrc = textSrc + 1
  EndIf
EndProcedure

; ---------------------------------------------------------------- the scene
; Object i takes a step, turns at its limits, flips its animation and is
; drawn. The first alien's step is the fleet's footstep.
Procedure MoveObject()
  t = ?ObjectTable + (i << 3)
  ox = PeekA(t) + ObjX(i)
  If ObjDir(i) = 0
    ox = ox + PeekA(t + 4)
    If ox >= PeekA(t + 6) : ObjDir(i) = 1 : EndIf
  Else
    ox = ox - PeekA(t + 4)
    If ox <= PeekA(t + 5) : ObjDir(i) = 0 : EndIf
  EndIf
  ObjX(i) = ox - PeekA(t)
  of = PeekA(t + 7) - ObjFrame(i)
  ObjFrame(i) = of
  Blit(ox, PeekA(t + 1), ?SpriteCols + PeekA(t + 2) + of, PeekA(t + 3))
  If i = 0
    i8080_out(5, 1 << fleetNote)
    fleetNote = (fleetNote + 1) & 3
    fleetOff = 3
  EndIf
EndProcedure

; What moves on this pass of the main loop: alien (pass mod 16) - so the
; formation turns in a wave, one alien a pass - and on other passes the UFO
; or the cannon. Counting passes, not frames, keeps the formation together
; even when a pass runs late.
Procedure Objects()
  i = loops & 15
  If i < 12 : MoveObject() : EndIf
  If (loops & 7) = 1 : i = 12 : MoveObject() : EndIf
  If (loops & 3) = 3 : i = 13 : MoveObject() : EndIf
EndProcedure

Procedure TickerStep()
  v = PeekA(?MarqueeText + tickPos)
  If v = 0
    tickPos = 0 : v = PeekA(?MarqueeText)
  EndIf
  Blit(tickX, #ROW_TICKER, ?FontCols + ((v - 32) << 3), 8)
  tickPos = tickPos + 1
  tickX = tickX + 8
  If tickX >= 224 : tickX = 0 : EndIf
  Blit(tickX, #ROW_TICKER, ?FontCols, 8)          ; a blank ahead of the next character
EndProcedure

; ---------------------------------------------------------------- music
Procedure MusicStep()
  v = Word(?MelodyPeriods + (tuneStep << 1))
  If v
    i8080_out($10, v & 255) : i8080_out($11, v >> 8) : melVol = 11
  EndIf
  v = Word(?BassPeriods + (tuneStep << 1))
  If v
    i8080_out($14, v & 255) : i8080_out($15, v >> 8)
  EndIf
  v = PeekA(?DrumSteps + tuneStep)
  If v
    i8080_out($1C, PeekA(?DrumPitch + v)) : drumVol = PeekA(?DrumLevel + v)
  EndIf
  tuneStep = (tuneStep + 1) & 63
EndProcedure

; The tune's frame: the step every eighth frame, the lead's fade, the drums'
; decay.
Procedure Music()
  If stepTick >= 8                     ; counted by RST2: real frames, even after a late pass
    stepTick = stepTick - 8
    MusicStep()
  EndIf
  If melVol > 5 And (stepTick & 1) : melVol = melVol - 1 : EndIf
  i8080_out($12, melVol)
  If drumVol > 2 : drumVol = drumVol - 3 : Else : drumVol = 0 : EndIf
  i8080_out($1E, drumVol)
EndProcedure

; ---------------------------------------------------------------- the loop
Procedure Begin()
  i8080_out($17, 2) : i8080_out($16, 13) : i8080_out($1F, 3)   ; a triangle bass at 13, noise drums
EndProcedure

Procedure Scene()
  Music()
  If phase = 0
    WipeStep()
  ElseIf phase = 1
    If seen & 1 : TypeStep() : EndIf
  Else
    Objects()
    If (seen & 7) = 4 : TickerStep() : EndIf
  EndIf
  If fleetOff
    fleetOff = fleetOff - 1
    If fleetOff = 0 : i8080_out(5, 0) : EndIf
  EndIf
EndProcedure

Procedure Main()
  Begin()
  EnableInterrupts
  Repeat
    While frame = (seen & 255) : Wend   ; once a frame
    seen = frame
    loops = loops + 1
    i8080_out(6, 0)                    ; the watchdog
    Scene()
  ForEver
EndProcedure

Main()
