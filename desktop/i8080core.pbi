CompilerIf #CPU_MEMMAP = 1
Procedure.i CpuRead(adr.i)
  If CpuMemMap(adr >> 8) & 1
    ProcedureReturn M(adr)
  EndIf
  ProcedureReturn CpuReadTrap(adr) & 255
EndProcedure
Procedure CpuWrite(adr.i, v.i)
  If CpuMemMap(adr >> 8) & 2
    M(adr) = v
  Else
    CpuWriteTrap(adr, v)
  EndIf
EndProcedure
Macro Rd(adr) : CpuRead(adr) : EndMacro
Macro Wr(adr, v) : CpuWrite(adr, v) : EndMacro
CompilerElse
Macro Rd(adr) : M(adr) : EndMacro
Macro Wr(adr, v) : M(adr) = v : EndMacro
CompilerEndIf

Macro Push16(v)
  Res = (CpuSP - 2) & $FFFF
  CpuSP = Res
  Wr((Res + 1) & $FFFF, (v) >> 8)
  Wr(Res, (v) & 255)
EndMacro
Macro Pop16(v)
  Res = Rd((CpuSP + 1) & $FFFF) << 8
  v = Res | Rd(CpuSP)
  CpuSP = (CpuSP + 2) & $FFFF
EndMacro
Macro Charge(c)
  Left = Left - c
EndMacro
Macro PackFlags(v)
  v = 2 | ((FA ! FR) & $10) | ((FC >> 8) & 1) | Parity((FR ! (FR >> 8)) & 255)
  If FR & $8080
    v = v | $80
  EndIf
  If (FR & 255) = 0
    v = v | $40
  EndIf
EndMacro
Macro SetFlags(p)
  MemVal = p
  FC = (MemVal & 1) << 8
  If MemVal & $40
    FR = (MemVal & $80) << 8
  Else
    FR = (MemVal & $80) | 1
  EndIf
  If Parity((FR ! (FR >> 8)) & 255) <> (MemVal & 4)
    FR = FR | $100
  EndIf
  FA = (MemVal & $10) ! FR
EndMacro

Procedure CpuInitTables()
  Protected i.i, b.i, n.i, cyc.a
  For i = 0 To 255
    n = 0
    For b = 0 To 7
      n = n + ((i >> b) & 1)
    Next
    If n & 1
      Parity(i) = 0
    Else
      Parity(i) = 4
    EndIf
  Next
  Restore CpuCycleData
  For i = 0 To 255
    Read.a cyc
    CycTab(i) = cyc
  Next
  ParityReady = 1
EndProcedure
Procedure.i CpuFlags()
  Protected v.i
  PackFlags(v)
  ProcedureReturn v
EndProcedure
Procedure CpuSetFlags(p.i)
  SetFlags(p)
EndProcedure
Procedure CpuReset()
  If ParityReady = 0
    CpuInitTables()
  EndIf
  CpuPC = 0 : CpuA = 0 : CpuBC = 0 : CpuDE = 0 : CpuHL = 0 : CpuSP = 0
  CpuSetFlags(2)
  CpuIE = 0 : CpuHalted = 0 : CpuEiDelay = 0 : CpuYield = 0 : CpuInstr = 0
EndProcedure
Procedure.i CpuInterrupt(opcode.i)
  If opcode < 0 Or opcode > 255
    ProcedureReturn 0
  EndIf
  If (opcode & $C7) <> $C7
    ProcedureReturn 0
  EndIf
  If CpuIE = 0 Or CpuEiDelay <> 0
    ProcedureReturn 0
  EndIf
  CpuIE = 0
  CpuHalted = 0
  Push16(CpuPC)
  CpuPC = opcode & $38
  ProcedureReturn 11
EndProcedure

