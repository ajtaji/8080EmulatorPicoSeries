OpD3: ; $D3 OUT, 10 cycles
  Tmp = M(CpuPC)
  CpuPC = (CpuPC + 1) & $FFFF
  CpuPortOut(Tmp, CpuA)
  NextOpChecked(10)

OpD4: ; $D4 CNC, 11 cycles
  If (FC & $100) = 0
    Res = M((CpuPC + 1) & $FFFF) << 8
    Ea = Res | M(CpuPC)
    CpuPC = (CpuPC + 2) & $FFFF
    Push16(CpuPC)
