OpC9: ; $C9 RET, 10 cycles
  Pop16(CpuPC)
  NextOp10()

OpCA: ; $CA JZ, 10 cycles
  If (FR & 255) = 0
    Res = M((CpuPC + 1) & $FFFF) << 8
    CpuPC = Res | M(CpuPC)
  Else
    CpuPC = (CpuPC + 2) & $FFFF
  EndIf
  NextOp10()

OpCB: ; $CB JMP (undocumented), 10 cycles
  Res = M((CpuPC + 1) & $FFFF) << 8
  CpuPC = Res | M(CpuPC)
